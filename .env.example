# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Socratica
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (required for full functionality)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://socratica:changeme@localhost:5432/socratica

# ─── Langflow ─────────────────────────────────────────────────────────────────
# Langflow is running in Docker (ibm-hacktiv8-langflow/compose.yaml).
# Container: langflow | Port: 7860 | LANGFLOW_AUTO_LOGIN=true
#
# FastAPI running on host machine:
LANGFLOW_BASE_URL=http://localhost:7860
# FastAPI running in Docker (same network):
# LANGFLOW_BASE_URL=http://langflow:7860
#
# API key — leave empty if LANGFLOW_AUTO_LOGIN=true
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_SECONDS=30

# Flow IDs — fill in after importing flows into Langflow UI
# Get flow ID from: Langflow UI → Flow → API → Flow ID
LANGFLOW_INGESTION_FLOW_ID=
LANGFLOW_RETRIEVAL_FLOW_ID=
LANGFLOW_SOCRATIC_FLOW_ID=
LANGFLOW_EVALUATOR_FLOW_ID=
LANGFLOW_GUARDRAIL_FLOW_ID=

# ─── LLM (Google Gemini) ──────────────────────────────────────────────────────
# Configured centrally inside Langflow (Langflow UI -> Settings -> Global Variables).
# FastAPI backend does not require or store Gemini API keys.
LLM_PROVIDER=gemini

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Qdrant vector database (configured inside Langflow flows)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=socratica

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL — must match the Next.js dev server or production origin.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── File Upload ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,md,py,js,ts,java,cpp,c

# ─── RAG Configuration ───────────────────────────────────────────────────────
# These are passed as tweaks to Langflow flows. Values are evaluated against
# an evaluation set; do not hardcode as final.
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.70
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ─── Escalation ──────────────────────────────────────────────────────────────
ESCALATION_CONFIDENCE_THRESHOLD=0.70

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Used by Next.js to call the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
